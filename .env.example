# Copy to .env.local. Never commit real keys.
# Create two keys at https://aistudio.google.com/apikey then restrict each
# in Google Cloud Console → APIs & Services → Credentials.

# --- Local (npm run dev) ---
# Server-only proxy key. Do not prefix with VITE_.
# Leave Application restrictions as "None" (or IP), API restriction = Gemini only.
# HTTP referrers do not apply here because Node calls Gemini, not the browser.
GEMINI_API_KEY=

# Optional local browser key, used instead of the proxy when set.
# Restrict this key with HTTP referrers:
#   http://localhost:5173
#   http://localhost:5173/*
#   http://127.0.0.1:5173
#   http://127.0.0.1:5173/*
#   http://localhost:4173
#   http://localhost:4173/*
# VITE_GEMINI_API_KEY=

# --- Production (GitHub Pages) ---
# Do not put the prod key in this file. Add it as a repo secret named
# VITE_GEMINI_API_KEY, then the deploy workflow bakes it into the static build.
# Restrict that key with HTTP referrers:
#   https://himanshuc3.github.io/wikipaw
#   https://himanshuc3.github.io/wikipaw/*
#   https://himanshuc3.github.io
#   https://himanshuc3.github.io/*
# Also set API restriction to Generative Language API (Gemini) only.

# Optional. Defaults to gemini-3.6-flash
# GEMINI_MODEL=gemini-3.6-flash
# VITE_GEMINI_MODEL=gemini-3.6-flash

# Optional. Defaults to /wikipaw/ in production builds.
# VITE_BASE_PATH=/wikipaw/
